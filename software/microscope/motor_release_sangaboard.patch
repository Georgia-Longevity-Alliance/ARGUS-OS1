From bc2adfdffe2996f4c62848252c029367aa958527 Mon Sep 17 00:00:00 2001
From: Jaba Tqemaladze <jaba@longevity.ge>
Date: Wed, 12 Aug 2026 23:45:12 +0400
Subject: [PATCH] Add release_motors action to SangaboardThing

De-energise the stepper motor coils via the existing 'release' command
in Sangaboard firmware and pysangaboard's release_motors() method.

This disengages holding torque so the stage can be moved by hand, and
removes the heat generated by holding the motors energised - important
in temperature-controlled enclosures (e.g. incubators). Motors are
automatically re-energised by the next move.

Part of ARGUS-OS1 (Georgia Longevity Alliance) contribution upstream.
---
 .../things/stage/sangaboard.py                    | 15 +++++++++++++++
 tests/unit_tests/test_sangaboard.py               |  6 ++++++
 2 files changed, 21 insertions(+)

diff --git a/src/openflexure_microscope_server/things/stage/sangaboard.py b/src/openflexure_microscope_server/things/stage/sangaboard.py
index 7ab3103..d747ee1 100644
--- a/src/openflexure_microscope_server/things/stage/sangaboard.py
+++ b/src/openflexure_microscope_server/things/stage/sangaboard.py
@@ -242,6 +242,21 @@ class SangaboardThing(BaseStage):
             self._sangaboard.zero_position()
         self.update_position()
 
+    @lt.action
+    def release_motors(self) -> None:
+        """De-energise the stepper motor coils, releasing the stage.
+
+        This disengages the holding torque on all axes, so the stage can be
+        moved by hand. It also removes the heat generated by holding the
+        motors energised, which is important in temperature-controlled
+        enclosures (e.g. incubators). The motors are automatically re-energised
+        by the next move.
+
+        Requires Sangaboard firmware with the ``release`` command.
+        """
+        with self._hardware_lock:
+            self._sangaboard.release_motors()
+
     def set_led(
         self,
         led_on: bool = True,
diff --git a/tests/unit_tests/test_sangaboard.py b/tests/unit_tests/test_sangaboard.py
index 1be144d..0aaf119 100644
--- a/tests/unit_tests/test_sangaboard.py
+++ b/tests/unit_tests/test_sangaboard.py
@@ -79,3 +79,9 @@ def test_valid_firmware(mock_sanga_thing, caplog):
         with caplog.at_level(logging.WARNING):
             mock_sanga_thing.check_firmware()
         assert len(caplog.records) == 0
+
+
+def test_release_motors(mock_sanga_thing):
+    """Check release_motors de-energises the stepper coils."""
+    mock_sanga_thing.release_motors()
+    mock_sanga_thing._sangaboard.release_motors.assert_called_once_with()
